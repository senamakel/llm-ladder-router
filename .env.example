# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env

# Surplus Intelligence marketplace credential. Used for inference and for the
# buyer balance poll; the order book needs no authentication.
SURPLUS_API_KEY=replace-me

# OpenRouter marketplace credential. Used for inference, the per-sub-provider
# price listing, and the credits poll.
OPENROUTER_API_KEY=replace-me

# Venice inference credential, for the `uncensored` ladder's direct rung.
# Venice is a direct endpoint: this key buys inference and nothing else, since
# there is no order book to read and no balance to poll.
VENICE_INFERENCE_KEY=

# The key callers must present to this router, when `config.toml` sets
# `server.api_key_env` instead of an inline `server.api_key`.
# LADDER_API_KEY=replace-me

# Log filter for the `tracing` ecosystem.
# RUST_LOG=info

# Backtraces for local debugging: 1 for a short backtrace, "full" for all frames.
# RUST_BACKTRACE=1
