# Build output
/target/
**/*.rs.bk
*.pdb

# Coverage output
/coverage/
/coverage.json
*.profraw
*.profdata
lcov.info

# Local secrets — never commit; copy .env.example to .env
.env
.env.local

# Linked worktrees created by the local `worktree` helper
worktrees/*
!worktrees/.gitkeep

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Background server pidfile and log from scripts/run-server
.run/
# Local router configuration. It carries the caller api_key and any
# site-specific ceilings, so only config.example.toml is committed.
config.toml
